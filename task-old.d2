# ============================================================
# BPMN タスク要素
#
# lib/bpmn.d2 から import されるコンポーネント
# アイコン: ../icons/ 配下の SVG (bpmn-svg-mapping.csv 参照)
#
# 使い方:
#   承認.class: user-task
#   承認: 承認処理
#
# 規約:
#   - アイコンは図形の下中央に配置 (BPMN マーカー位置)
#   - アイコンサイズは図形の高さの 1/2 で自動決定
#     (サイズを変える場合は vars.bpmn.task-height を調整)
#   - task-width / task-height はクラス適用時にサイズとして働く
#     (D2 に最小値指定はないため固定サイズで代用。
#      個別に上書きする場合は要素側で width / height を指定)
# ============================================================

classes: {
  # --------------------------------------------------------
  # 汎用タスク (角丸矩形, アイコンなし)
  # --------------------------------------------------------
  task: {
    width: ${bpmn.task-width}
    height: ${bpmn.task-height}
    style: {
      fill: ${bpmn.task-fill}
      stroke: ${bpmn.task-stroke}
      stroke-width: 2
      border-radius: 6
    }
  }

  # --------------------------------------------------------
  # タスク種別 (下中央のアイコンで識別)
  # --------------------------------------------------------
  # ユーザータスク (人間の作業)
  user-task: {
    icon: ../icons/task-user.svg
    icon.near: bottom-center
    width: ${bpmn.task-width}
    height: ${bpmn.task-height}
    style: {
      fill: ${bpmn.task-fill}
      stroke: ${bpmn.task-stroke}
      stroke-width: 2
      border-radius: 6
    }
  }
  # マニュアルタスク (手作業)
  manual-task: {
    icon: ../icons/task-manual.svg
    icon.near: bottom-center
    width: ${bpmn.task-width}
    height: ${bpmn.task-height}
    style: {
      fill: ${bpmn.task-fill}
      stroke: ${bpmn.task-stroke}
      stroke-width: 2
      border-radius: 6
    }
  }
  # サービスタスク (システム自動処理)
  service-task: {
    icon: ../icons/task-service.svg
    icon.near: bottom-center
    width: ${bpmn.task-width}
    height: ${bpmn.task-height}
    style: {
      fill: ${bpmn.task-fill}
      stroke: ${bpmn.task-stroke}
      stroke-width: 2
      border-radius: 6
    }
  }
  # スクリプトタスク (スクリプト実行)
  script-task: {
    icon: ../icons/task-script.svg
    icon.near: bottom-center
    width: ${bpmn.task-width}
    height: ${bpmn.task-height}
    style: {
      fill: ${bpmn.task-fill}
      stroke: ${bpmn.task-stroke}
      stroke-width: 2
      border-radius: 6
    }
  }
  # ビジネスルールタスク (ルールエンジンによる判定)
  business-rule-task: {
    icon: ../icons/task-business-rule.svg
    icon.near: bottom-center
    width: ${bpmn.task-width}
    height: ${bpmn.task-height}
    style: {
      fill: ${bpmn.task-fill}
      stroke: ${bpmn.task-stroke}
      stroke-width: 2
      border-radius: 6
    }
  }
  # 送信タスク (メッセージ送信)
  send-task: {
    icon: ../icons/task-send.svg
    icon.near: bottom-center
    width: ${bpmn.task-width}
    height: ${bpmn.task-height}
    style: {
      fill: ${bpmn.task-fill}
      stroke: ${bpmn.task-stroke}
      stroke-width: 2
      border-radius: 6
    }
  }
  # 受信タスク (メッセージ受信)
  receive-task: {
    icon: ../icons/task-receive.svg
    icon.near: bottom-center
    width: ${bpmn.task-width}
    height: ${bpmn.task-height}
    style: {
      fill: ${bpmn.task-fill}
      stroke: ${bpmn.task-stroke}
      stroke-width: 2
      border-radius: 6
    }
  }
}
