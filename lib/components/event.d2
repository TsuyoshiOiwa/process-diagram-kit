# ============================================================
# BPMN イベント種別 (クラス集)
#
# 使い方:
#   ...@../lib/bpmn                  # vars (アイコンDir) のために必須
#   (bpmn.d2 が本ファイルを spread import して再公開するため、
#    通常は ...@../lib/bpmn だけで本ファイルのクラスも使える)
#
#   タイマー.class: intermediate-timer-catch-event
#   タイマー: 10分経過
#
# 構成 (全 36種・新SVGセットと 1:1):
#   - 開始系 9種: 単一細枠の円 + 種別アイコン
#       none / メッセージ / タイマー / 条件 / シグナル /
#       複合 / 並列複合 / エスカレーション / エラー
#   - 中間系 18種: 二重円 + 種別アイコン
#       none / メッセージ / タイマー / 条件 / リンク /
#       シグナル / 複合 / 並列複合 / エスカレーション /
#       補償 / キャンセル / エラー (キャッチ・スロー別)
#   - 終了系 9種: 太枠の円 + 種別アイコン
#       none / メッセージ / エスカレーション / エラー /
#       キャンセル / 補償 / シグナル / 複合 / 終了
#
# 規約:
#   - SVG アイコン側に外枠の円 (単一 / 二重 / 太線) が
#     含まれるため、クラスは shape: image でアイコンを
#     そのまま表示する (D2 側での枠描画・色指定は不要)
#   - ラベルは円の外上部に配置 (label.near: outside-top-center)
#
# アイコンパスについて:
#   クラス内の icon は「図ファイルの位置」基準で解決されるため、
#   vars.bpmn.icon-dir (lib/bpmn.d2 で定義) を経由して参照する。
#   図が別階層にある場合は図側で vars.bpmn.icon-dir を上書き
#   すること (task.d2 と同じ仕組み)。
# ============================================================

classes: {
  # --------------------------------------------------------
  # 開始イベント (単一細枠の円 + アイコン)
  # --------------------------------------------------------
  # none (アイコンなし開始イベント)
  start-none-event: {
    shape: image
    icon: ${bpmn.icon-dir}/start-none-event.svg
    label.near: outside-top-center
    style.font-size: 12
    width: 48
    height: 48
  }
  # message start event
  start-message-event: {
    shape: image
    icon: ${bpmn.icon-dir}/start-message-event.svg
    label.near: outside-top-center
    style.font-size: 12
    width: 48
