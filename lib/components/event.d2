  # --------------------------------------------------------
  # 独自拡張 (BPMN 非標準)
  # --------------------------------------------------------
  # 通知イベント (本ライブラリ独自拡張)
  #   catch = 受信側: 特定受信者宛ての非同期通知の到着を
  #           待機 (中間) / プロセス開始のトリガー (開始) にする
  #   throw = 送信側: 特定受信者宛ての非同期通知を発行する
  #   発行側 (タスクまたは throw) と受信側は
  #   lib/components/stroke.d2 の notification-flow
  #   (「<->」接続) で結ぶ
  #
  #   ※ 開始系は他種別と異なり catch を名前に含める
  #     (catch / throw の対応を種別内で明示するため)
  # 通知開始イベント (catch)
  start-notification-catch-event: {
    shape: image
    icon: ${bpmn.icon-dir}/start-notification-catch-event.svg
    label.near: outside-top-center
    style.font-size: 12
    width: 48
    height: 48
  }
  # 通知キャッチ中間イベント (catch)
  intermediate-notification-catch-event: {
    shape: image
    icon: ${bpmn.icon-dir}/intermediate-notification-catch-event.svg
    label.near: outside-top-center
    style.font-size: 12
    width: 48
    height: 48
  }
  # 通知スロー中間イベント (throw)
  intermediate-notification-throw-event: {
    shape: image
    icon: ${bpmn.icon-dir}/intermediate-notification-throw-event.svg
    label.near: outside-top-center
    style.font-size: 12
    width: 48
    height: 48
  }
  # 通知スロー終了イベント (throw)
  end-notification-throw-event: {
    shape: image
    icon: ${bpmn.icon-dir}/end-notification-throw-event.svg
    label.near: outside-top-center
    style.font-size: 12
    width: 48
    height: 48
  }

  # --------------------------------------------------------
