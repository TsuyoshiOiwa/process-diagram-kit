    style.font-size: 12
    width: 48
    height: 48
  }
  # parallel multiple start event
  start-parallel-multiple-event: {
    shape: image
    icon: ${bpmn.icon-dir}/start-parallel-multiple-event.svg
    label.near: outside-top-center
    style.font-size: 12
    width: 48
    height: 48
  }
  # escalation start event
  start-escalation-event: {
    shape: image
    icon: ${bpmn.icon-dir}/start-escalation-event.svg
    label.near: outside-top-center
    style.font-size: 12
    width: 48
    height: 48
  }
  # error start event
  start-error-event: {
    shape: image
    icon: ${bpmn.icon-dir}/start-error-event.svg
    label.near: outside-top-center
    style.font-size: 12
    width: 48
    height: 48
