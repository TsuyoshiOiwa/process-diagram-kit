    label.near: outside-top-center
    style.font-size: 12
    width: 48
    height: 48
  }
  # compensation intermediate throw event
  intermediate-compensation-throw-event: {
    shape: image
    icon: ${bpmn.icon-dir}/intermediate-compensation-throw-event.svg
    label.near: outside-top-center
