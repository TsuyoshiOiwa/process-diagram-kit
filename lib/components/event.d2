    width: 48
    height: 48
  }
  # multiple intermediate throw event
  intermediate-multiple-throw-event: {
    shape: image
    icon: ${bpmn.icon-dir}/intermediate-multiple-throw-event.svg
    label.near: outside-top-center
    style.font-size: 12
    width: 48
    height: 48
  }
  # parallel multiple intermediate catch event
  intermediate-parallel-multiple-catch-event: {
    shape: image
    icon: ${bpmn.icon-dir}/intermediate-parallel-multiple-catch-event.svg
    label.near: outside-top-center
    style.font-size: 12
    width: 48
    height: 48
  }
  # escalation intermediate catch event
  intermediate-escalation-catch-event: {
    shape: image
    icon: ${bpmn.icon-dir}/intermediate-escalation-catch-event.svg
    label.near: outside-top-center
    style.font-size: 12
    width: 48
    height: 48
  }
  # escalation intermediate throw event
  intermediate-escalation-throw-event: {
    shape: image
    icon: ${bpmn.icon-dir}/intermediate-escalation-throw-event.svg
    label.near: outside-top-center
