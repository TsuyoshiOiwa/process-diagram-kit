  # message intermediate throw event
  intermediate-message-throw-event: {
    shape: image
    icon: ${bpmn.icon-dir}/intermediate-message-throw-event.svg
    label.near: outside-top-center
    style.font-size: 12
    width: 48
    height: 48
  }
  # timer intermediate catch event
  intermediate-timer-catch-event: {
    shape: image
    icon: ${bpmn.icon-dir}/intermediate-timer-catch-event.svg
    label.near: outside-top-center
    style.font-size: 12
    width: 48
    height: 48
  }
  # conditional intermediate catch event
  intermediate-conditional-catch-event: {
    shape: image
    icon: ${bpmn.icon-dir}/intermediate-conditional-catch-event.svg
    label.near: outside-top-center
    style.font-size: 12
    width: 48
    height: 48
  }
  # link intermediate catch event
  intermediate-link-catch-event: {
    shape: image
    icon: ${bpmn.icon-dir}/intermediate-link-catch-event.svg
    label.near: outside-top-center
    style.font-size: 12
    width: 48
    height: 48
  }
  # link intermediate throw event
  intermediate-link-throw-event: {
    shape: image
    icon: ${bpmn.icon-dir}/intermediate-link-throw-event.svg
    label.near: outside-top-center
    style.font-size: 12
    width: 48
    height: 48
  }
  # signal intermediate catch event
  intermediate-signal-catch-event: {
    shape: image
    icon: ${bpmn.icon-dir}/intermediate-signal-catch-event.svg
    label.near: outside-top-center
    style.font-size: 12
    width: 48
    height: 48
  }
  # signal intermediate throw event
  intermediate-signal-throw-event: {
