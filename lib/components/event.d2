  start-conditional-event: {
    shape: image
    icon: ${bpmn.icon-dir}/start-conditional-event.svg
    label.near: outside-top-center
    style.font-size: 12
    width: 48
    height: 48
  }
  # signal start event
  start-signal-event: {
    shape: image
    icon: ${bpmn.icon-dir}/start-signal-event.svg
    label.near: outside-top-center
    style.font-size: 12
    width: 48
    height: 48
  }
  # multiple start event
  start-multiple-event: {
