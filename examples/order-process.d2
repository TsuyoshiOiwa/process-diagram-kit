# ============================================================
# サンプル: 受注処理プロセス
#   lib/bpmn.d2 のクラスと lib/components/ のテンプレートを
#   使った BPMN 図の例
# ============================================================
...@../lib/bpmn

direction: right

# ---- プール: 顧客 ----
顧客: @../lib/components/container.pool
顧客: 顧客
顧客: {
  注文.class: start-none-event
  注文: 注文
  入金確認.class: end-none-event
  入金確認: 入金確認済
}

# ---- プール: 自社 ----
自社: @../lib/components/container.pool
自社: 自社
自社: {
  # ---- レーン: 営業 ----
  営業: @../lib/components/container.lane
  営業: 営業
  営業: {
    受注確認: @../lib/components/task.task
    受注確認: 受注内容確認
    受注可否.class: exclusive-gateway
    受注可否: 受注可否
    受注登録: @../lib/components/task.task
    受注登録: 受注登録
    お断り: @../lib/components/task.task
    お断り: 丁重にお断り
    断了.class: end-none-event
    断了: 終了
  }

  # ---- レーン: 経理 ----
  経理: @../lib/components/container.lane
  経理: 経理
  経理: {
    請求書発行: @../lib/components/task.task
    請求書発行: 請求書発行
    入金消込: @../lib/components/task.task
    入金消込: 入金消込
    完了.class: end-none-event
    完了: 完了
  }

  # ---- シーケンスフロー ----
  営業.受注確認 -> 営業.受注可否
  営業.受注可否 -> 営業.受注登録: 可
  営業.受注可否 -> 営業.お断り: 不可
  営業.お断り -> 営業.断了
  営業.受注登録 -> 経理.請求書発行
  経理.請求書発行 -> 経理.入金消込
  経理.入金消込 -> 経理.完了
}

# ---- メッセージフロー (プール間, 始点円のため <-> で接続) ----
顧客.注文 <-> 自社.営業.受注確認: {
  class: message-flow
  label: 注文書
}
自社.経理.請求書発行 <-> 顧客.入金確認: {
  class: message-flow
  label: 請求書
}
