# ============================================================
# UC-01004 記憶原本の登録
#   - 元定義: works/ref-UC-01001.d2 (UC-01001 知識の新規登録の分割)
#   - 構成: POL-001 開発部
#   - 備考: 開始イベントは 1 つとし、再登録する / 原本再アップロードの
#           経路選択は前段 (BUC-01001) のゲートウェイが担う
#   - 備考: GTW-003001 (排他) で記憶原本の登録結果を判定し、
#           失敗時は TSK-001003 (再アップロード) に戻す
#   - 備考: 成功時は TSK-003012 で知識構築タスクを登録し、GTW-003003 (並列) で
#           知識構築 (UC-03001) を非同期起動 (合流なし) しつつ、
#           知識構築タスクを表示 (TSK-003004) し知識管理者に確認 (TSK-001019) する
#   - 備考: 知識構築の結果はメッセージスローで BUC-01001 に通知
#           (日をまたぐ非同期)
# ============================================================
...@../lib/bpmn

direction: down

title: |md
  # UC-01004 記憶原本の登録
  更新日時: 2026-10-15
|
title.near: top-center

# ------------------------------------------------------------
# POL-001 プール: 開発部
# ------------------------------------------------------------
POL-001: @../lib/components/container.pool
POL-001: 開発部 (POL-001)
POL-001: {
  top: 0
  left: 0
  direction: down

  # ---- ACT-001 レーン: 知識管理者 ----
  ACT-001: @../lib/components/container.lane
  ACT-001: 知識管理者 (ACT-001)
  ACT-001: {
    top: 0
    left: 0
    direction: right

    # ---- 開始イベント ----
    開始.class: start-none-event
    開始: 登録開始
    開始.top: 0
    開始.left: 0

    # ---- タスク ----
    TSK-001007: @../lib/components/task.task
    TSK-001007.desc.label: "記憶原本登録の\n必要情報を表示する"
    TSK-001007.top: 0
    TSK-001007.left: 300

    TSK-001008: @../lib/components/task.task
    TSK-001008.desc.label: "記憶原本登録に\n必要な情報を確認する"
    TSK-001008.top: 0
    TSK-001008.left: 600

    TSK-001001: @../lib/components/task.task
    TSK-001001.desc.label: 記憶原本を用意する
    TSK-001001.top: 0
    TSK-001001.left: 900

    TSK-001002: @../lib/components/task.task
    TSK-001002.desc.label: "記憶原本基本情報を\n登録する"
    TSK-001002.top: 0
    TSK-001002.left: 1200

    TSK-001003: @../lib/components/task.task
    TSK-001003.desc.label: "記憶原本を\nアップロードする"
    TSK-001003.top: 0
    TSK-001003.left: 1700

    # ---- ゲートウェイ ----
    GTW-001004.class: exclusive-gateway
    GTW-001004: 登録結果
    GTW-001004.top: 0
    GTW-001004.left: 1500

    TSK-001019: @../lib/components/task.task
    TSK-001019.desc.label: "知識構築タスクを\n確認する"
    TSK-001019.top: 0
    TSK-001019.left: 2900

    # ---- 終了イベント ----
    処理終了.class: end-none-event
    処理終了.top: 0
    処理終了.left: 3200
  }

  # ---- A6T-003 レーン: システム ----
  ACT-003: @../lib/components/container.lane
  ACT-003: システム (ACT-003)
  ACT-003: {
    top: 800
    left: 0
    direction: right

    # ---- 必要情報返却 (照会に応答) ----
    TSK-003006: @../lib/components/task.task
    TSK-003006.desc.label: "記憶原本登録の\n必要情報を返却する"
    TSK-003006.top: 0
    TSK-003006.left: 600

    # ---- 基本情報登録処理 ----
    TSK-003001: @../lib/components/task.task
    TSK-003001.desc.label: "記憶原本基本情報の\n新規登録を行う"
    TSK-003001.top: 0
    TSK-003001.left: 1200

    # ---- 原本登録・知識構築処理 ----
    TSK-003002: @../lib/components/task.task
    TSK-003002.desc.label: "記憶原本の\n新規登録を行う"
    TSK-003002.top: 0
    TSK-003002.left: 1700

    GTW-003001.class: exclusive-gateway
    GTW-003001: 登録結果
    GTW-003001.top: 0
    GTW-003001.left: 2000

    TSK-003012: @../lib/components/task.task
    TSK-003012.desc.label: "知識構築タスクを\n登録する"
    TSK-003012.top: 0
    TSK-003012.left: 2300

    GTW-003003.class: parallel-gateway
    GTW-003003: 知識構築タスク登録後続処理
    GTW-003003.top: 0
    GTW-003003.left: 2600

    TSK-003004: @../lib/components/task.task
    TSK-003004.desc.label: "知識構築タスク情報を\n表示する"
    TSK-003004.top: 0
    TSK-003004.left: 2900

    UC-03001.class: end-none-event
    UC-03001.top: 320
    UC-03001.left: 2900
  }

  # ---- データ ----
  TRANSFER-00.class: data-object
  TRANSFER-00: "DAO-004\n知識種別定義"

  ACT-003.TSK-003006 -> TRANSFER-00: {
    class: data-association
  }
  TRANSFER-00 -> ACT-001.TSK-001008: {
    class: data-association
  }

  TRANSFER-01.class: data-object
  TRANSFER-01: "DAO-001\n記憶原本"

  ACT-001.TSK-001003 -> TRANSFER-01: {
    class: data-association
  }
  TRANSFER-01 -> ACT-003.TSK-003002: {
    class: data-association
  }

  TRANSFER-02.class: data-object
  TRANSFER-02: "DAO-001\n記憶原本基本情報"

  ACT-001.TSK-001002 -> TRANSFER-02: {
    class: data-association
  }
  TRANSFER-02 -> ACT-003.TSK-003001: {
    class: data-association
  }

  TRANSFER-03.class: data-object
  TRANSFER-03: "DAO-006\n知識構築タスク"

  ACT-003.TSK-003012 -> TRANSFER-03: {
    class: data-association
  }
  TRANSFER-03 -> ACT-003.TSK-003004: {
    class: data-association
  }
  TRANSFER-03 -> ACT-001.TSK-001019: {
    class: data-association
  }

  # ---- シーケンスフロー ----
  ACT-001.開始 -> ACT-001.TSK-001007
  ACT-001.TSK-001007 -> ACT-003.TSK-003006
  ACT-003.TSK-003006 -> ACT-001.TSK-001008
  ACT-001.TSK-001008 -> ACT-001.TSK-001001
  ACT-001.TSK-001001 -> ACT-001.TSK-001002
  ACT-001.TSK-001002 -> ACT-003.TSK-003001
  ACT-003.TSK-003001 -> ACT-001.GTW-001004
  ACT-001.GTW-001004 -> ACT-001.TSK-001003: 成功
  ACT-001.GTW-001004 -> ACT-001.TSK-001002: 失敗
  ACT-001.TSK-001003 -> ACT-003.TSK-003002
  ACT-003.TSK-003002 -> ACT-003.GTW-003001
  ACT-003.GTW-003001 -> ACT-001.TSK-001003: 失敗
  ACT-003.GTW-003001 -> ACT-003.TSK-003012: 成功
  ACT-003.TSK-003012 -> ACT-003.GTW-003003
  ACT-003.GTW-003003 -> ACT-003.UC-03001: 知識構築処理
  ACT-003.GTW-003003 -> ACT-003.TSK-003004
  ACT-003.TSK-003004 -> ACT-001.TSK-001019
  ACT-001.TSK-001019 -> ACT-001.処理終了
}
