# ============================================================
# UC-01005 知識構築タスクの結果確認・レビュー
#   - 元定義: works/ref-UC-01001.d2 (UC-01001 知識の新規登録の分割)
#   - 構成: POL-001 開発部
#   - 備考: 開始イベントは 1 つとし、前段 (BUC-01001) の
#           メッセージ受信・ゲートウェイで経路が確定した後に開始する。
#           知識構築タスク情報の取得 (TSK-001011) →
#           システムによる情報表示 (TSK-003004) →
#           知識内容の取得・表示 (TSK-001014 / TSK-003008) →
#           知識内容の確認 (TSK-001015) の順に実行する
#           (タスクの呼び出し形式は ref-UC-01001.d2 に準拠)
# ============================================================
...@../lib/bpmn

direction: down

title: |md
  # UC-01005 構築した知識のレビュー
  更新日時: 2026/10/10
|
title.near: top-center

# ------------------------------------------------------------
# POL-001 プール: 開発部
# ------------------------------------------------------------
POL-001: @../lib/components/container.pool
POL-001: 開発部 (POL-001)
POL-001: {
  top: 0
  left: 0
  direction: down

  # ---- ACT-001 レーン: 知識管理者 ----
  ACT-001: @../lib/components/container.lane
  ACT-001: 知識管理者 (ACT-001)
  ACT-001: {
    top: 0
    left: 0
    direction: right

    # ---- 開始イベント ----
    開始.class: start-none-event
    開始: 確認開始
    開始.top: 0
    開始.left: 0

    # ---- タスク ----
    TSK-001011: @../lib/components/task.task
    TSK-001011.desc.label: "知識構築タスク情報を\n取得する"
    TSK-001011.top: 0
    TSK-001011.left: 300

    TSK-001014: @../lib/components/task.task
    TSK-001014.desc.label: "知識の内容を\n取得する"
    TSK-001014.top: 0
    TSK-001014.left: 900

    TSK-001015: @../lib/components/task.task
    TSK-001015.desc.label: "知識の内容を\n確認する"
    TSK-001015.top: 0
    TSK-001015.left: 1500

    # ---- 終了イベント ----
    終了レビュー.class: end-none-event
    終了レビュー: レビュー完了
    終了レビュー.top: 0
    終了レビュー.left: 1800
  }

  # ---- A6T-003 レーン: システム ----
  ACT-003: @../lib/components/container.lane
  ACT-003: システム (ACT-003)
  ACT-003: {
    top: 600
    left: 0
    direction: right

    # ---- 知識構築タスク情報表示 ----
    TSK-003004: @../lib/components/task.task
    TSK-003004.desc.label: "知識構築タスク情報を表示する"
    TSK-003004.top: 0
    TSK-003004.left: 600

    # ---- 知識情報取得 ----
    TSK-003008: @../lib/components/task.task
    TSK-003008.desc.label: 知識を表示する
    TSK-003008.top: 0
    TSK-003008.left: 1200
  }

  # ---- データ ----
  TRANSFER-01.class: data-object
  TRANSFER-01: "DAO-006\n知識構築タスク\nDAO-002\n知識"

  ACT-003.TSK-003004 -> TRANSFER-01: {
    class: data-association
  }
  TRANSFER-01 -> ACT-001.TSK-001014: {
    class: data-association
  }

  TRANSFER-02.class: data-object
  TRANSFER-02: "DAO-002\n知識"

  ACT-003.TSK-003008 -> TRANSFER-02: {
    class: data-association
  }
  TRANSFER-02 -> ACT-001.TSK-001015: {
    class: data-association
  }

  # ---- シーケンスフロー ----
  ACT-001.開始 -> ACT-001.TSK-001011
  ACT-001.TSK-001011 -> ACT-003.TSK-003004
  ACT-003.TSK-003004 -> ACT-001.TSK-001014
  ACT-001.TSK-001014 -> ACT-003.TSK-003008
  ACT-003.TSK-003008 -> ACT-001.TSK-001015
  ACT-001.TSK-001015 -> ACT-001.終了レビュー
}
