# ============================================================
# BPMN プロセス図テンプレート
#   新規図はこのファイルをコピーして編集する
# ============================================================
...@../lib/bpmn

direction: right

# ------------------------------------------------------------
# プール (組織 / システムの境界)
# ------------------------------------------------------------
プールA: @../lib/components/container.pool
プールA: プールA
プールA: {
  # ----------------------------------------------------------
  # レーン (担当区分)
  # ----------------------------------------------------------
  レーン1: @../lib/components/container.lane
  レーン1: レーン1
  レーン1: {
    # ---- 開始イベント ----
    開始.class: start-none-event
    開始: 開始

    # ---- タスク (テンプレートを部分import、キーは要素 ID) ----
    TSK-000001: @../lib/components/task.task
    TSK-000001.desc.label: "タスク1の\n処理内容"

    # ---- 排他ゲートウェイ ----
    判定.class: exclusive-gateway
    判定: 判定条件

    # ---- 終了イベント ----
    終了.class: end-none-event
    終了: 完了
  }

  レーン2: @../lib/components/container.lane
  レーン2: レーン2
  レーン2: {
    TSK-000002: @../lib/components/task.task
    TSK-000002.desc.label: "タスク2の\n処理内容"
  }

  # ---- シーケンスフロー ----
  レーン1.開始 -> レーン1.TSK-000001
  レーン1.TSK-000001 -> レーン1.判定
  レーン1.判定 -> レーン1.終了: Yes
  レーン1.判定 -> レーン2.TSK-000002: No
  レーン2.TSK-000002 -> レーン1.終了
}

