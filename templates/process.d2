# ============================================================
# BPMN プロセス図テンプレート
#   新規図はこのファイルをコピーして編集する
# ============================================================
...@../lib/bpmn

direction: right

# ------------------------------------------------------------
# プール (組織 / システムの境界)
# ------------------------------------------------------------
プールA: @../lib/components/container.pool
プールA: プールA
プールA: {
  # ----------------------------------------------------------
  # レーン (担当区分)
  # ----------------------------------------------------------
  レーン1: @../lib/components/container.lane
  レーン1: レーン1
  レーン1: {
    # ---- 開始イベント ----
    開始.class: start-none-event
    開始: 開始

    # ---- タスク (テンプレートを部分import) ----
    タスク1: @../lib/components/task.task
    タスク1: タスク1の名称

    # ---- 排他ゲートウェイ ----
    判定.class: exclusive-gateway
    判定: 判定条件

    # ---- 終了イベント ----
    終了.class: end-none-event
    終了: 完了
  }

  レーン2: @../lib/components/container.lane
  レーン2: レーン2
  レーン2: {
    タスク2: @../lib/components/task.task
    タスク2: タスク2の名称
  }

  # ---- シーケンスフロー ----
  レーン1.開始 -> レーン1.タスク1
  レーン1.タスク1 -> レーン1.判定
  レーン1.判定 -> レーン1.終了: Yes
  レーン1.判定 -> レーン2.タスク2: No
  レーン2.タスク2 -> レーン1.終了
}

# ------------------------------------------------------------
# 種別付きタスクの使用例 (必要に応じてコメントを外す)
#   タスク名と説明文 (desc) は要素ごとに編集できる
# ------------------------------------------------------------
# 承認: @../lib/components/task.user-task
# 承認: 承認処理
# 承認.desc: 人間が確認して承認する

# ------------------------------------------------------------
# 別プールとのメッセージフロー (必要に応じてコメントを外す)
# ------------------------------------------------------------
# プールB: @../lib/components/container.pool
# プールB: プールB
# プールB.受信: @../lib/components/task.receive-task
# プールB.受信: 受信タスク
#
# プールA.レーン1.タスク1 <-> プールB.受信: {
#   class: message-flow
#   label: メッセージ
# }
